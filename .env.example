# Copy this file to `.env` for local development.
# `.env` is gitignored — it must never be committed.
# In GitHub Actions, the same variable names are set under repo Settings → Secrets and variables → Actions.

# === Toast ===
# Generate at: Toast Web → Integrations → API Access → Standard API Access
TOAST_KIZUKI_CLIENT_ID=
TOAST_KIZUKI_CLIENT_SECRET=
TOAST_SD_CLIENT_ID=
TOAST_SD_CLIENT_SECRET=

# === Stripe (QR code donations) ===
# Restricted API key from the QR donation Stripe account.
# Dashboard → Developers → API keys → Create restricted key
# Permissions needed: PaymentIntents (read), Checkout Sessions (read)
STRIPE_API_KEY=

# === Shopify (frozen dumpling sales) ===
# Custom App Admin API access token.
# Shopify Admin → Settings → Apps and sales channels → Develop apps → Create app
# Scopes needed: read_orders
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_STORE_DOMAIN=          # e.g. supreme-dumplings.myshopify.com
